<?xml version="1.0" encoding="utf-8"?>
<!-- Seed unattend for round 42 Scheme A (MIC-PE).
     Runs the official Professional install.wim through specialize once,
     then through OOBE, so Windows' own flow generates the SAM and
     SECURITY databases the clean rebuild needs as seed input. No network,
     no software, no password: OOBE creates the MICPE administrator
     (blank password, Administrators group) and AutoLogon signs it in.
     The desktop screenshot is itself the blank-password proof.
     Shape reference: SYSTEM-Intel-MIC/winbuild New-UnattendXml
     (windowsPE LabConfig bypass, SkipOobe, BypassNRO). Only the shape
     is taken: no slimming (too slow), no Office, no MAS activation,
     and the seed stays on 22621.1105 (winbuild defaults to 28020).
     Note: the winbuild repo has no account handling (it creates no
     users in OOBE); the UserAccounts/AutoLogon below come from the
     documented oobeSystem mechanism, not from winbuild. SkipUserOOBE
     only skips the user-creation UI; it does not stop UserAccounts
     from creating MICPE. The built-in Administrator (RID 500) stays
     disabled; the logon account is MICPE (RID 1000).
     Placed at <applied>:\Windows\Panther\unattend.xml by
     Invoke-CleanSamSeedRun.ps1. Never shipped in the PE image. -->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <ComputerName>SEEDVM</ComputerName>
        </component>
        <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <RunSynchronous>
                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Path>cmd /c "reg add HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE /v BypassNRO /t REG_DWORD /d 1 /f &amp; exit 0"</Path>
                    <Description>BypassNRO: let OOBE create a local account with no network</Description>
                </RunSynchronousCommand>
            </RunSynchronous>
        </component>
    </settings>
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <SkipMachineOOBE>true</SkipMachineOOBE>
                <SkipUserOOBE>true</SkipUserOOBE>
                <ProtectYourPC>3</ProtectYourPC>
            </OOBE>
            <UserAccounts>
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Name>MICPE</Name>
                        <DisplayName>MICPE</DisplayName>
                        <Group>Administrators</Group>
                        <Password>
                            <Value></Value>
                            <PlainText>true</PlainText>
                        </Password>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            <AutoLogon>
                <Username>MICPE</Username>
                <Enabled>true</Enabled>
                <LogonCount>1</LogonCount>
                <Password>
                    <Value></Value>
                    <PlainText>true</PlainText>
                </Password>
            </AutoLogon>
        </component>
    </settings>
</unattend>
