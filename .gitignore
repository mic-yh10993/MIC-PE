# Build artifacts and downloaded payloads
*.wim
*.esd
*.swm
*.iso
*.zip
*.7z
*.msi
*.cab
*.exe
*.dll
!tools/**/*.exe
!tests/fixtures/**/*.exe
!tests/fixtures/**/*.dll
# app/ packages are committed by design (user decision 2026-11-17 15:07):
# the payload archive and the split volumes live in git. *.7z above still
# ignores build residue staged next to install.bat at build time.
!app/payload/micpe-payload.7z
!app/chrome/*.7z.*
!app/office/*.7z.*

# Shell replacers are committed unpacked (user decision 2026-11-22): they are
# small, and keeping the vendor directory layout in git is what makes "drop in
# a newer StartAllBack folder" a copy instead of a re-pack.
!app/startallback/files/**
!app/startallback/vendor/**
!app/start11/files/**

# The UWP boot chain's own payload is committed too (user decision 2026-11-22).
# src/uwp/payload/winshell/ is the WinXShell binary tree the chain installs
# into "Program Files\WinXShell"; src/uwp/payload/apprepository/ holds the
# StateRepository .srd databases AppX needs before any package can activate.
# Without them the chain still builds, but it warns and the image loses the
# shell helper and the AppRepository.
!src/uwp/payload/**

# The native-logon helper assets are REQUIRED by the build: src/build/lib/
# Wim.ps1 asserts on LSAgetRights_x64.exe and Security.cab before it can
# enable the built-in Administrator, so a checkout without them fails the
# native-logon stage instead of degrading.
!assets/logon/**

# Local work directories
/work/
/out/
/artifacts/
/tmp/
*.log

# PowerShell
*.ps1xml
!src/**/*.ps1xml

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Python (generators)
__pycache__/
*.pyc
